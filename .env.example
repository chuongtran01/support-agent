POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support
DATABASE_URL=postgresql+psycopg://support:support@localhost:5433/support

OPENAI_API_KEY=
AGENT_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6-luna
# How hard the agent model thinks: none, low, medium or high
AGENT_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small

# Refunds above this amount (USD) are held for human approval
REFUND_APPROVAL_THRESHOLD=200

# Model calls in one turn before the chat is handed to a person
AGENT_MAX_STEPS=6

# Knowledge search below this best vector score (0 to 1) is flagged low confidence
LOW_CONFIDENCE_SCORE=0.45

# Signs login tokens: use a long random value outside local development
JWT_SECRET=dev-only-secret-change-me-before-deploying
TOKEN_TTL_MINUTES=480
# Browser origins allowed to call the API, separated by commas
CORS_ORIGINS=http://localhost:3000

# The password every seeded demo customer logs in with
SEED_PASSWORD=demo

# Tracing to Langfuse Cloud. Leave the keys empty to turn tracing off. The base URL is your
# project's region, as Langfuse shows it (https://cloud.langfuse.com for EU,
# https://us.cloud.langfuse.com for US); empty uses the SDK's default
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Reorder search results with a local cross-encoder. Off: it scored worse on the agent eval
# (docs/PHASE6.md). Needs: pip install -e ".[rerank]"
RERANK_ENABLED=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Model failures: the longest wait for the next piece of a reply, tries again after a failed
# call that showed nothing yet, and the seconds after which a turn hands over instead of
# starting another model call
MODEL_TIMEOUT_SECONDS=60
MODEL_RETRIES=1
MODEL_RETRY_DELAY_SECONDS=1
AGENT_TURN_DEADLINE_SECONDS=120

# The MCP tool server (make mcp). It shares the database and JWT_SECRET with the API. Listening
# on anything but this machine needs a real JWT_SECRET: it will not start on the default one.
# MCP_SERVER_URL is where a client (the agent, from phase 8) finds it
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://localhost:8765/mcp
